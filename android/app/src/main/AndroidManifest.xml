<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нужен для отправки ответов учителю. Остальное приложение работает без интернета. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Уведомления о новых заданиях, оценках, сообщениях и сроках сдачи (Android 13+ спрашивает разрешение). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Звонки с учителем курса: голос и видео. Приложение спрашивает разрешение, только когда звонят или звонишь сам. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Камера и микрофон не обязательны: без них приложение ставится и работает, только звонить нельзя. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".HimiyaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProstayaHimiya">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Звонок в курсе (страница звонка с сайта). Не пересоздаётся при повороте, чтобы звонок не обрывался. -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />
    </application>

    <!-- Чтобы ссылки на теорию открывались во встроенной вкладке браузера (Custom Tabs). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
